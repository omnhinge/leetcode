class Solution {
    public boolean checkDivisibility(int n) {
        int No = n;
        int Npro =1;
        int Nadd = 0;
        while(n>0){
            int digit = n%10;
            Nadd = Nadd +digit;
            Npro = Npro * digit;
            n=n/10;
        }
        return No % (Nadd + Npro) ==0;
    }
}